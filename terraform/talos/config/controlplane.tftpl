cluster:
  etcd:
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
machine:
  certSANs:
  - ${vip}
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: ${vip}
link: eth0
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
resources:
  requests:
    cpu: "1"
    memory: 2.5Gi
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
extraArgs:
  bind-address: 0.0.0.0
resources:
  requests:
    cpu: 250m
    memory: 250Mi
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
extraArgs:
  bind-address: 0.0.0.0
resources:
  requests:
    cpu: 50m
    memory: 50Mi
